# ==========================================
# CONFIGURACIÓN DEL ENTORNO DE PRODUCCIÓN
# ==========================================
PORT=3000

# Base de Datos
DATABASE_URL=postgres://user:password@localhost:5432/omnipresence
REDIS_URL=redis://localhost:6379

# ==========================================
# CREDENCIALES DE DESARROLLADOR OAUTH
# (Obtener en developer.facebook.com y developer.tiktok.com)
# ==========================================

# Meta Graph API (Facebook & Instagram)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/channels/oauth/meta/callback

# TikTok Business API
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/channels/oauth/tiktok/callback

# LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/channels/oauth/linkedin/callback
