# ─── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DOMAIN_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/omnipresence

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=genera_con_node_-e_require('crypto').randomBytes(64).toString('hex')
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Encryption ───────────────────────────────────────
TOKEN_ENCRYPTION_KEY=genera_con_node_-e_require('crypto').randomBytes(32).toString('hex')

# ─── Ollama ───────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings

# ─── Whisper ──────────────────────────────────────────
WHISPER_PATH=./whisper.cpp/main
WHISPER_MODEL_PATH=./whisper.cpp/models/ggml-base.bin

# ─── Vision AI ────────────────────────────────────────
VISION_API_URL=http://localhost:8000/v1/chat/completions

# ─── Telegram ─────────────────────────────────────────
TELEGRAM_TOKEN=123456:ABC-DEF1234...

# ─── Meta (Facebook/Instagram/WhatsApp) ───────────────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=omnipresence_verify_2026
WHATSAPP_PHONE_NUMBER_ID=

# ─── Stripe ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=

# ─── Storage ──────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=omnipresence-assets

# ─── Emails ───────────────────────────────────────────
RESEND_API_KEY=

# ─── Chatbot Module AI Providers (Free Tiers) ────────
# GROQ_API_KEY=gsk_... (30 RPM gratis, más rápido)
# NVIDIA_API_KEY=nvapi-... (1,000-5,000 créditos gratis, 40 RPM)
# GEMINI_API_KEY=AIza... (15 RPM, 1,500 req/día gratis, 1M contexto)
